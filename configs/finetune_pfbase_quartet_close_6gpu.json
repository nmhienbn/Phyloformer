{
  "train_trees": "data/paper_pfbase/train/trees",
  "train_alignments": "data/paper_pfbase/train/msas",
  "val_trees": "data/paper_pfbase/val/trees",
  "val_alignments": "data/paper_pfbase/val/msas",
  "base_model": "pretrained_models/pf_base.ckpt",
  "nb_blocks": 6,
  "embed_dim": 64,
  "nb_heads": 4,
  "dropout": 0.0,
  "n_seqs": 50,

  "nb_epochs": 4,
  "warmup_steps": 3000,
  "learning_rate": 0.0001,

  "check_val_every": 3000,
  "batch_size": 3,
  "accumulate_grad_batches": 4,

  "loss": "quartet_close",
  "quartet_close_sigma": 0.1,
  "quartet_num_samples": 2000,

  "no_improvement_stop": 5,
  "hard_loss_ceiling": 3.0,
  "output_dir": "runs/pfbase_quartet_close",
  "project_name": "PHYLOFORMER_EXPERIMENTS",
  "run_name": "PFBASE_FINETUNE_QCLOSE_6GPU",
  "wandb_sync": true,
  "accelerator": "gpu",
  "devices": 6,
  "num_nodes": 1,
  "strategy": "ddp_find_unused_parameters_false",
  "ignore_slurm_env": true,
  "precision": "32-true"
}
